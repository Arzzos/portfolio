---
interface Props {
  lang: 'es' | 'en';
  t: any;
}
const { lang, t } = Astro.props;
const c = t.contact;
---

<section id="contacto" aria-labelledby="contacto-title" class="mx-auto max-w-5xl scroll-mt-20 px-4 py-12">
  <h2 id="contacto-title" class="text-2xl font-bold sm:text-3xl" data-reveal>
    {c.title}
  </h2>
  <p class="mt-2 opacity-70" data-reveal>
    {c.subtitle}
  </p>
  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <form
      data-reveal
      id="contact-form"
      method="post"
      action="/api/contact"
      data-success={c.success}
      data-error={c.error}
      class="surface surface-border space-y-4 rounded-xl border p-5"
    >
      <div>
        <label for="cf-name" class="mono text-xs uppercase tracking-wide opacity-70">
          {c.name}
        </label>
        <input
          id="cf-name"
          name="name"
          type="text"
          required
          autocomplete="name"
          maxlength="100"
          class="input-border mt-1 w-full rounded border bg-transparent px-3 py-2"
        />
      </div>
      <div>
        <label for="cf-email" class="mono text-xs uppercase tracking-wide opacity-70">
          {c.email}
        </label>
        <input
          id="cf-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          maxlength="254"
          class="input-border mt-1 w-full rounded border bg-transparent px-3 py-2"
        />
      </div>
      <div>
        <label for="cf-message" class="mono text-xs uppercase tracking-wide opacity-70">
          {c.message}
        </label>
        <textarea
          id="cf-message"
          name="message"
          required
          rows="5"
          maxlength="5000"
          class="input-border mt-1 w-full rounded border bg-transparent px-3 py-2"
        ></textarea>
      </div>
      <p id="cf-status" role="status" aria-live="polite" class="mono hidden text-sm"></p>
      <div id="cf-turnstile" class="min-h-[65px]"></div>
      <button
        type="submit"
        class="btn-primary inline-flex w-full items-center justify-center rounded px-6 font-semibold hover:brightness-110"
      >
        {c.send}
      </button>
      <p class="mono text-[11px] opacity-50">{c.note}</p>
    </form>
    <div data-reveal class="flex flex-col justify-center gap-4">
      <a
        href="https://wa.me/525521053389?text=Hola%20Rasiel%2C%20vi%20tu%20portfolio%20en%20arzzos.com"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center rounded border border-current px-6 hover:opacity-80"
      >
        {c.whatsapp}
      </a>
      <a href="mailto:hola@arzzos.com" class="mono text-sm underline opacity-80 hover:opacity-100">
        hola@arzzos.com
      </a>
      <a
        href="https://github.com/Arzzos"
        target="_blank"
        rel="noopener"
        class="mono text-sm underline opacity-80 hover:opacity-100"
      >
        github.com/Arzzos
      </a>
    </div>
  </div>
</section>

<script is:inline data-cf-lang={lang}>
  // Turnstile explicit render (single-use tokens: reset after every attempt).
  const SITEKEY = '0x4AAAAAAFSdRj1UQdP8paSq';
  const ACTION = 'contact';
  let widgetId = null;
  let sending = false;

  const currentTheme = () => (document.documentElement.classList.contains('light') ? 'light' : 'dark');

  let widgetRendered = false;

  // Turnstile api.js (~28KB) is injected only when the contact section
  // approaches: it never blocks initial load.
  let apiLoading = null;

  function renderWidget() {
    if (!window.turnstile) return;
    const container = document.getElementById('cf-turnstile');
    if (!container) return;
    if (widgetId !== null) {
      try {
        window.turnstile.remove(widgetId);
      } catch {
        /* already gone */
      }
      widgetId = null;
    }
    container.innerHTML = '';
    widgetRendered = true;
    widgetId = window.turnstile.render(container, {
      sitekey: SITEKEY,
      action: ACTION,
      theme: currentTheme(),
    });
  }

  // Kick off lazy load immediately: the script parses while the user reads.
  scheduleWidgetRender();
  window.addEventListener('arzzos-theme', () => {
    if (widgetRendered) renderWidget();
  });

  function loadTurnstileApi() {
    if (window.turnstile) return Promise.resolve();
    if (!apiLoading) {
      apiLoading = new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
        s.async = true;
        s.defer = true;
        s.onload = () => resolve();
        s.onerror = () => reject(new Error('turnstile api failed'));
        document.head.appendChild(s);
      });
    }
    return apiLoading;
  }

  function scheduleWidgetRender() {
    if (widgetRendered) return;
    const section = document.getElementById('contacto');
    const render = () => loadTurnstileApi().then(renderWidget, () => {});
    if (!section || !('IntersectionObserver' in window)) {
      render();
      return;
    }
    // The widget pulls ~250KB of challenge code: only render when the
    // contact section approaches the viewport (plus a fallback delay).
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          render();
        }
      },
      { rootMargin: '600px' },
    );
    io.observe(section);
    setTimeout(() => {
      io.disconnect();
      render();
    }, 12000);
  }

  const form = document.getElementById('contact-form');
  const status = document.getElementById('cf-status');
  const submitBtn = form?.querySelector('button[type="submit"]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (sending) return;
    const fd = new FormData(form);
    const token = fd.get('cf-turnstile-response');
    sending = true;
    if (submitBtn) submitBtn.disabled = true;
    status.classList.remove('hidden');
    status.textContent = '…';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          name: fd.get('name'),
          email: fd.get('email'),
          message: fd.get('message'),
          turnstileToken: typeof token === 'string' ? token : '',
        }),
      });
      status.textContent = res.ok ? (form.dataset.success ?? 'OK') : (form.dataset.error ?? 'Error');
      if (res.ok) form.reset();
    } catch {
      status.textContent = form.dataset.error ?? 'Error';
    } finally {
      sending = false;
      if (submitBtn) submitBtn.disabled = false;
      if (widgetId !== null) {
        try {
          window.turnstile.reset(widgetId);
        } catch {
          /* widget gone */
        }
      }
    }
  });
</script>
