---
interface Props {
  t: any;
}
const { t } = Astro.props;
---

<section id="sobre-mi" aria-labelledby="sobre-mi-title" class="mx-auto max-w-5xl scroll-mt-20 px-4 py-12">
  <div class="grid gap-10 md:grid-cols-[200px_1fr]">
    <div data-reveal>
      <img
        src="/pfp.jpeg"
        alt="Rasiel Espinal"
        width="200"
        height="200"
        loading="lazy"
        class="surface-border aspect-square w-40 rounded-2xl border object-cover md:w-full"
      />
    </div>
    <div>
      <h2 id="sobre-mi-title" class="text-2xl font-bold sm:text-3xl" data-reveal>
        {t.about.title}
      </h2>
      <div class="mt-4 max-w-2xl space-y-4 opacity-85">
        {t.about.paragraphs.map((p: string) => (
          <p data-reveal>{p}</p>
        ))}
      </div>
    </div>
  </div>
</section>

<section aria-labelledby="exp-title" class="mx-auto max-w-5xl px-4 py-12">
  <h2 id="exp-title" class="text-2xl font-bold sm:text-3xl" data-reveal>
    {t.experience.title}
  </h2>
  <div class="mt-6 space-y-6">
    {t.experience.items.map((job: any) => (
      <article data-reveal class="surface surface-border rounded-xl border p-5">
        <h3 class="font-bold">{job.role}</h3>
        <p class="mono text-xs opacity-60">
          {job.org} · {job.period}
        </p>
        <ul class="mt-3 list-disc space-y-1 ps-5 text-sm opacity-85">
          {job.bullets.map((b: string) => (
            <li>{b}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<section aria-labelledby="stack-title" class="mx-auto max-w-5xl px-4 py-12">
  <h2 id="stack-title" class="text-2xl font-bold sm:text-3xl" data-reveal>
    {t.stack.title}
  </h2>
  <dl class="mt-6 grid gap-4 sm:grid-cols-2">
    {t.stack.groups.map((g: any) => (
      <div data-reveal class="surface surface-border rounded-xl border p-4">
        <dt class="mono text-xs uppercase tracking-wide opacity-60">{g.name}</dt>
        <dd class="mt-1 text-sm font-medium">{g.items}</dd>
      </div>
    ))}
  </dl>
</section>
