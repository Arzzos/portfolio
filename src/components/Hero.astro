---
interface Props {
  t: any;
}

const { t } = Astro.props;
const h = t.hero;
---

<section class="mx-auto max-w-5xl px-4 pb-16 pt-14 sm:pt-20" aria-labelledby="hero-name">
  <p class="mono accent-text text-sm" data-reveal>
    {h.kicker}
  </p>
  <h1 id="hero-name" class="mt-3 max-w-3xl text-4xl font-bold leading-tight sm:text-6xl" data-reveal>
    {h.name}
  </h1>
  <p class="mono mt-4 text-lg opacity-90" data-reveal>
    {h.role}
  </p>
  <p class="mt-3 max-w-2xl text-lg opacity-80" data-reveal>
    {h.tagline}
  </p>
  <p class="mono hero-badge mt-4 inline-block rounded px-3 py-2 text-xs" data-reveal>
    ★ {h.badge}
  </p>
  <p class="mono mt-4 text-xs opacity-60" data-reveal>
    {h.stackLine}
  </p>
  <div class="mt-8 flex flex-wrap gap-3" data-reveal>
    <a
      href="#trabajo"
      class="btn-primary inline-flex items-center rounded px-6 font-semibold hover:brightness-110"
    >
      {h.ctaWork}
    </a>
    <a href="#contacto" class="inline-flex items-center rounded border border-current px-6 hover:opacity-80">
      {h.ctaContact}
    </a>
  </div>
</section>
